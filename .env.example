# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API / API Keys).
# Leave both empty to run the offline demo with fictional data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. It is safe in the browser: Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=

# NEVER put the service_role / secret key or the database password in this file
# or anywhere in the front end. They belong only in Supabase (Edge Function secrets).
