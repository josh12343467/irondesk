# Security headers for Netlify / Cloudflare Pages (copied into dist/ on build).
# The Content-Security-Policy itself ships as a <meta> tag in index.html (built from your Supabase URL),
# so it works everywhere, including GitHub Pages, which ignores this file.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
